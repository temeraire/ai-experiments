<mujoco model="greek_room">
  <compiler angle="radian" inertiafromgeom="true"/>
  <option gravity="0 0 -9.81" integrator="RK4" timestep="0.01"/>

  <default>
    <joint armature="0.1" damping="2" limited="true"/>
    <geom contype="1" conaffinity="1" friction="0.8 0.3 0.1"/>
  </default>

  <asset>
    <texture builtin="checker" height="100" name="texfloor" rgb1="0.85 0.82 0.75" rgb2="0.78 0.75 0.68" type="2d" width="100"/>
    <material name="MatFloor" reflectance="0.2" shininess="0.3" specular="0.3" texrepeat="12 12" texture="texfloor"/>
    <texture builtin="flat" height="100" name="texcolumn" rgb1="0.9 0.88 0.82" rgb2="0.85 0.82 0.76" type="2d" width="100"/>
    <material name="MatColumn" texture="texcolumn"/>
    <texture builtin="flat" height="100" name="texground" rgb1="0.4 0.35 0.3" rgb2="0.4 0.35 0.3" type="2d" width="100"/>
    <material name="MatGround" texture="texground"/>
  </asset>

  <worldbody>
    <light cutoff="100" diffuse="1 0.95 0.85" dir="-0.2 -0.3 -1" directional="true"
           pos="0 0 6" specular="0.3 0.25 0.2"/>
    <!-- Warm fill light from the side -->
    <light cutoff="100" diffuse="0.3 0.28 0.22" dir="0.5 0.5 -0.5" directional="true"
           pos="-3 -3 4" specular="0 0 0"/>

    <!-- Ground below (where you land if you fall) -->
    <geom name="ground" type="plane" size="10 10 0.1" pos="0 0 0"
          rgba="0.4 0.35 0.3 1" material="MatGround"/>

    <!-- ============================================================ -->
    <!-- THE PLATFORM (elevated marble floor)                         -->
    <!-- 3m x 3m, 2m up. Larger than v8 to allow room for columns.   -->
    <!-- ============================================================ -->
    <geom name="platform" type="box" size="1.5 1.5 0.04" pos="0 0 2.0"
          rgba="0.85 0.82 0.75 1" material="MatFloor"/>

    <!-- Low step around the edge (you can feel it with your hand before going over) -->
    <geom name="step_N" type="box" size="1.5 0.03 0.02" pos="0 1.47 2.02"
          rgba="0.8 0.77 0.7 1"/>
    <geom name="step_S" type="box" size="1.5 0.03 0.02" pos="0 -1.47 2.02"
          rgba="0.8 0.77 0.7 1"/>
    <geom name="step_E" type="box" size="0.03 1.5 0.02" pos="1.47 0 2.02"
          rgba="0.8 0.77 0.7 1"/>
    <geom name="step_W" type="box" size="0.03 1.5 0.02" pos="-1.47 0 2.02"
          rgba="0.8 0.77 0.7 1"/>

    <!-- Edge markers (visual) -->
    <geom name="edge_N" type="capsule" fromto="-1.5 1.5 2.04 1.5 1.5 2.04" size="0.008"
          rgba="0.7 0.3 0.3 0.6" contype="0" conaffinity="0"/>
    <geom name="edge_S" type="capsule" fromto="-1.5 -1.5 2.04 1.5 -1.5 2.04" size="0.008"
          rgba="0.7 0.3 0.3 0.6" contype="0" conaffinity="0"/>
    <geom name="edge_E" type="capsule" fromto="1.5 -1.5 2.04 1.5 1.5 2.04" size="0.008"
          rgba="0.7 0.3 0.3 0.6" contype="0" conaffinity="0"/>
    <geom name="edge_W" type="capsule" fromto="-1.5 -1.5 2.04 -1.5 1.5 2.04" size="0.008"
          rgba="0.7 0.3 0.3 0.6" contype="0" conaffinity="0"/>

    <!-- ============================================================ -->
    <!-- THE COLUMNS                                                   -->
    <!-- Four Doric-style columns. Simple cylinders, thick enough to  -->
    <!-- hide the target ball behind them. Arranged asymmetrically so -->
    <!-- there's no trivial pattern to exploit.                       -->
    <!-- ============================================================ -->

    <!-- Column A: front-left area -->
    <geom name="column_A" type="cylinder" size="0.12 0.35" pos="-0.6 0.5 2.39"
          rgba="0.92 0.89 0.82 1" material="MatColumn"/>
    <!-- Column base (wider, like a Doric base) -->
    <geom name="base_A" type="cylinder" size="0.16 0.04" pos="-0.6 0.5 2.08"
          rgba="0.88 0.85 0.78 1" material="MatColumn"/>
    <!-- Column capital -->
    <geom name="cap_A" type="cylinder" size="0.16 0.03" pos="-0.6 0.5 2.71"
          rgba="0.88 0.85 0.78 1" material="MatColumn" contype="0" conaffinity="0"/>

    <!-- Column B: back-right area -->
    <geom name="column_B" type="cylinder" size="0.12 0.35" pos="0.7 -0.4 2.39"
          rgba="0.92 0.89 0.82 1" material="MatColumn"/>
    <geom name="base_B" type="cylinder" size="0.16 0.04" pos="0.7 -0.4 2.08"
          rgba="0.88 0.85 0.78 1" material="MatColumn"/>
    <geom name="cap_B" type="cylinder" size="0.16 0.03" pos="0.7 -0.4 2.71"
          rgba="0.88 0.85 0.78 1" material="MatColumn" contype="0" conaffinity="0"/>

    <!-- Column C: front-right, closer to center -->
    <geom name="column_C" type="cylinder" size="0.12 0.35" pos="0.3 0.7 2.39"
          rgba="0.92 0.89 0.82 1" material="MatColumn"/>
    <geom name="base_C" type="cylinder" size="0.16 0.04" pos="0.3 0.7 2.08"
          rgba="0.88 0.85 0.78 1" material="MatColumn"/>
    <geom name="cap_C" type="cylinder" size="0.16 0.03" pos="0.3 0.7 2.71"
          rgba="0.88 0.85 0.78 1" material="MatColumn" contype="0" conaffinity="0"/>

    <!-- Column D: back-left -->
    <geom name="column_D" type="cylinder" size="0.12 0.35" pos="-0.5 -0.7 2.39"
          rgba="0.92 0.89 0.82 1" material="MatColumn"/>
    <geom name="base_D" type="cylinder" size="0.16 0.04" pos="-0.5 -0.7 2.08"
          rgba="0.88 0.85 0.78 1" material="MatColumn"/>
    <geom name="cap_D" type="cylinder" size="0.16 0.03" pos="-0.5 -0.7 2.71"
          rgba="0.88 0.85 0.78 1" material="MatColumn" contype="0" conaffinity="0"/>

    <!-- ============================================================ -->
    <!-- A simple low wall / bench (adds variety to occlusion)        -->
    <!-- Like a stone bench between two columns                       -->
    <!-- ============================================================ -->
    <geom name="bench" type="box" size="0.4 0.06 0.08" pos="0.0 -0.1 2.12"
          rgba="0.82 0.78 0.72 1"/>

    <!-- ============================================================ -->
    <!-- THE CREATURE (same skateboard dude from v8)                  -->
    <!-- ============================================================ -->
    <body name="torso" pos="0 0 2.12">
      <joint name="root" type="free" armature="0" damping="0" limited="false"/>
      <!-- Torso body (visual + mass) -->
      <geom name="torso_geom" type="box" size="0.15 0.1 0.04"
            rgba="0.6 0.5 0.4 1" density="400"
            contype="0" conaffinity="0"/>
      <!-- Four wheels -->
      <geom name="wheel_fl" type="sphere" size="0.025"
            pos="-0.12 0.07 -0.04" rgba="0.3 0.3 0.3 1"
            friction="0.02 0.005 0.001" density="100"/>
      <geom name="wheel_fr" type="sphere" size="0.025"
            pos="0.12 0.07 -0.04" rgba="0.3 0.3 0.3 1"
            friction="0.02 0.005 0.001" density="100"/>
      <geom name="wheel_bl" type="sphere" size="0.025"
            pos="-0.12 -0.07 -0.04" rgba="0.3 0.3 0.3 1"
            friction="0.02 0.005 0.001" density="100"/>
      <geom name="wheel_br" type="sphere" size="0.025"
            pos="0.12 -0.07 -0.04" rgba="0.3 0.3 0.3 1"
            friction="0.02 0.005 0.001" density="100"/>
      <geom name="torso_skid" type="box" size="0.14 0.09 0.005"
            pos="0 0 -0.035" rgba="0.5 0.45 0.35 1" density="50"
            contype="0" conaffinity="0"/>
      <!-- Torso underside touch -->
      <site name="torso_touch" pos="0 0 -0.05" size="0.08" rgba="0 0 0 0"/>

      <!-- LEFT ARM -->
      <body name="left_shoulder" pos="-0.15 0 0.02">
        <joint name="left_shoulder_pitch" type="hinge" axis="0 1 0" range="-1.5 1.5"/>
        <joint name="left_shoulder_roll" type="hinge" axis="1 0 0" range="-0.8 1.5"/>
        <geom name="left_upper_arm" type="capsule" fromto="0 0 0 -0.18 0 -0.02"
              size="0.025" rgba="0.6 0.5 0.4 1"/>
        <body name="left_forearm" pos="-0.18 0 -0.02">
          <joint name="left_elbow" type="hinge" axis="0 1 0" range="-2.0 0.1"/>
          <geom name="left_forearm_geom" type="capsule" fromto="0 0 0 -0.15 0 -0.02"
                size="0.02" rgba="0.6 0.5 0.4 1"/>
          <body name="left_hand" pos="-0.15 0 -0.02">
            <geom name="left_hand_geom" type="sphere" size="0.03"
                  rgba="0.7 0.55 0.45 1"/>
            <site name="left_hand_touch" pos="0 0 0" size="0.031" rgba="0 0 0 0"/>
          </body>
        </body>
      </body>

      <!-- RIGHT ARM -->
      <body name="right_shoulder" pos="0.15 0 0.02">
        <joint name="right_shoulder_pitch" type="hinge" axis="0 1 0" range="-1.5 1.5"/>
        <joint name="right_shoulder_roll" type="hinge" axis="1 0 0" range="-1.5 0.8"/>
        <geom name="right_upper_arm" type="capsule" fromto="0 0 0 0.18 0 -0.02"
              size="0.025" rgba="0.6 0.5 0.4 1"/>
        <body name="right_forearm" pos="0.18 0 -0.02">
          <joint name="right_elbow" type="hinge" axis="0 1 0" range="-0.1 2.0"/>
          <geom name="right_forearm_geom" type="capsule" fromto="0 0 0 0.15 0 -0.02"
                size="0.02" rgba="0.6 0.5 0.4 1"/>
          <body name="right_hand" pos="0.15 0 -0.02">
            <geom name="right_hand_geom" type="sphere" size="0.03"
                  rgba="0.7 0.55 0.45 1"/>
            <site name="right_hand_touch" pos="0 0 0" size="0.031" rgba="0 0 0 0"/>
          </body>
        </body>
      </body>

      <!-- HEAD -->
      <body name="head_base" pos="0 0.08 0.06">
        <joint name="head_pan" type="hinge" axis="0 0 1" range="-1.5 1.5"/>
        <geom name="head_base_geom" type="sphere" size="0.015"
              rgba="0.6 0.5 0.4 1" contype="0" conaffinity="0"/>
        <body name="head" pos="0 0 0.03">
          <joint name="head_tilt" type="hinge" axis="1 0 0" range="-0.8 0.8"/>
          <geom name="head_geom" type="sphere" size="0.04"
                rgba="0.7 0.6 0.5 1" contype="0" conaffinity="0"/>
          <camera name="head_cam" pos="0 0.02 0" xyaxes="1 0 0 0 0.34 0.94" fovy="35"/>
        </body>
      </body>
    </body>

    <!-- ============================================================ -->
    <!-- TARGET BALL (can be placed behind any column by the env)     -->
    <!-- ============================================================ -->
    <body name="target" pos="0.5 0.5 2.08">
      <joint name="target_x" type="slide" axis="1 0 0" limited="true" range="-1.4 1.4"
             ref="0.5" armature="0" damping="0.5" stiffness="0"/>
      <joint name="target_y" type="slide" axis="0 1 0" limited="true" range="-1.4 1.4"
             ref="0.5" armature="0" damping="0.5" stiffness="0"/>
      <geom name="target_geom" type="sphere" size="0.035"
            rgba="0.9 0.15 0.15 1" density="200"/>
    </body>

    <!-- Cameras -->
    <camera name="overhead" pos="0 0 5.5" xyaxes="1 0 0 0 1 0" fovy="50"/>
    <camera name="side" pos="4.5 0 3" xyaxes="0 1 0 0 0 1" fovy="50"/>
    <!-- Perspective camera (like standing at the edge looking in) -->
    <camera name="perspective" pos="2.5 -2.5 3.5" xyaxes="0.7 0.7 0 -0.2 0.2 0.95" fovy="45"/>
  </worldbody>

  <actuator>
    <motor name="left_shoulder_pitch_motor" joint="left_shoulder_pitch"
           ctrllimited="true" ctrlrange="-1 1" gear="30"/>
    <motor name="left_shoulder_roll_motor" joint="left_shoulder_roll"
           ctrllimited="true" ctrlrange="-1 1" gear="30"/>
    <motor name="left_elbow_motor" joint="left_elbow"
           ctrllimited="true" ctrlrange="-1 1" gear="20"/>
    <motor name="right_shoulder_pitch_motor" joint="right_shoulder_pitch"
           ctrllimited="true" ctrlrange="-1 1" gear="30"/>
    <motor name="right_shoulder_roll_motor" joint="right_shoulder_roll"
           ctrllimited="true" ctrlrange="-1 1" gear="30"/>
    <motor name="right_elbow_motor" joint="right_elbow"
           ctrllimited="true" ctrlrange="-1 1" gear="20"/>
    <position name="head_pan_motor" joint="head_pan"
              ctrllimited="true" ctrlrange="-1.5 1.5" kp="30"/>
    <position name="head_tilt_motor" joint="head_tilt"
              ctrllimited="true" ctrlrange="-0.8 0.8" kp="30"/>
  </actuator>

  <sensor>
    <jointpos name="left_shoulder_pitch_pos" joint="left_shoulder_pitch"/>
    <jointpos name="left_shoulder_roll_pos" joint="left_shoulder_roll"/>
    <jointpos name="left_elbow_pos" joint="left_elbow"/>
    <jointpos name="right_shoulder_pitch_pos" joint="right_shoulder_pitch"/>
    <jointpos name="right_shoulder_roll_pos" joint="right_shoulder_roll"/>
    <jointpos name="right_elbow_pos" joint="right_elbow"/>
    <jointvel name="left_shoulder_pitch_vel" joint="left_shoulder_pitch"/>
    <jointvel name="left_shoulder_roll_vel" joint="left_shoulder_roll"/>
    <jointvel name="left_elbow_vel" joint="left_elbow"/>
    <jointvel name="right_shoulder_pitch_vel" joint="right_shoulder_pitch"/>
    <jointvel name="right_shoulder_roll_vel" joint="right_shoulder_roll"/>
    <jointvel name="right_elbow_vel" joint="right_elbow"/>
    <jointpos name="head_pan_pos" joint="head_pan"/>
    <jointpos name="head_tilt_pos" joint="head_tilt"/>
    <touch name="left_hand_touch" site="left_hand_touch"/>
    <touch name="right_hand_touch" site="right_hand_touch"/>
    <touch name="torso_touch" site="torso_touch"/>
  </sensor>
</mujoco>
