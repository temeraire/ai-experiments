<mujoco model="crawler">
  <compiler angle="radian" inertiafromgeom="true"/>
  <option gravity="0 0 -9.81" integrator="Euler" timestep="0.01" cone="elliptic"/>

  <default>
    <joint armature="0.05" damping="1.5" limited="true"/>
    <geom contype="1" conaffinity="1" friction="0.8 0.3 0.1"/>
  </default>

  <asset>
    <texture builtin="flat" height="100" name="texplatform" rgb1="0.72 0.72 0.68" rgb2="0.72 0.72 0.68" type="2d" width="100"/>
    <material name="MatPlatform" texture="texplatform"/>
    <texture builtin="flat" height="100" name="texground" rgb1="0.35 0.30 0.25" rgb2="0.35 0.30 0.25" type="2d" width="100"/>
    <material name="MatGround" texture="texground"/>
    <texture builtin="flat" height="100" name="texwall" rgb1="0.55 0.50 0.48" rgb2="0.55 0.50 0.48" type="2d" width="100"/>
    <material name="MatWall" texture="texwall"/>
  </asset>

  <worldbody>
    <light cutoff="100" diffuse="1 1 1" dir="0 0 -1" directional="true" pos="0 0 5" specular="0.2 0.2 0.2"/>

    <!-- Ground -->
    <geom name="ground" type="plane" size="10 10 0.1" pos="0 0 0" material="MatGround"
          conaffinity="1" contype="1"/>

    <!-- Platform: 2m x 2m, 5cm thick, top surface at z=2.025 -->
    <geom name="platform" type="box" size="1.0 1.0 0.025" pos="0 0 2.0"
          material="MatPlatform" conaffinity="1" contype="1"
          friction="0.9 0.3 0.1"/>

    <!-- Guardrails: low walls (12cm tall) around platform perimeter.
         Crawler bumps and bounces back — no fall termination. -->
    <geom name="rail_N" type="box" size="1.02 0.025 0.06" pos="0  1.025 2.085"
          material="MatWall" conaffinity="1" contype="1"/>
    <geom name="rail_S" type="box" size="1.02 0.025 0.06" pos="0 -1.025 2.085"
          material="MatWall" conaffinity="1" contype="1"/>
    <geom name="rail_E" type="box" size="0.025 1.02 0.06" pos=" 1.025 0 2.085"
          material="MatWall" conaffinity="1" contype="1"/>
    <geom name="rail_W" type="box" size="0.025 1.02 0.06" pos="-1.025 0 2.085"
          material="MatWall" conaffinity="1" contype="1"/>

    <!-- ============================================================
         THE CRAWLER

         Rest-pose geometry (qpos = 0):
           - Upper arm/thigh: horizontal, pointing outward (±X)
           - Forearm/shin:    vertical, pointing down (−Z)
           - Hand/foot:       sphere resting on platform surface

         Torso height chosen so hands and feet just touch platform top
         (z=2.025) at rest:
           platform + hand_radius(0.028) + forearm_len(0.12) +
           upper_arm_z_offset(0) + shoulder_z_rel_to_torso(-0.01)
           → torso_center = 2.025 + 0.028 + 0.12 + 0.01 = 2.183 ≈ 2.19

         Forward direction = +Y.
    ============================================================ -->
    <body name="torso" pos="0 0 2.19">
      <joint name="root" type="free" armature="0" damping="0" limited="false"/>
      <!-- Torso: wide front-to-back, skin-colored box -->
      <geom name="torso_geom" type="box" size="0.10 0.14 0.05"
            rgba="0.78 0.67 0.57 1" density="500"
            contype="1" conaffinity="1"/>

      <!-- ====== FRONT-LEFT ARM ====== -->
      <!-- Shoulder at front-left corner of torso, just below midline -->
      <body name="fl_shoulder" pos="-0.10 0.10 -0.01">
        <!-- Pitch: swings arm in X-Z plane (crawl stroke: push back, lift forward) -->
        <joint name="fl_shoulder_pitch" type="hinge" axis="0 1 0"
               range="-1.4 1.4"/>
        <!-- Yaw: swings arm in horizontal plane (steer left/right) -->
        <joint name="fl_shoulder_yaw" type="hinge" axis="0 0 1"
               range="-0.8 0.8"/>
        <!-- Upper arm: horizontal, pointing outward (-X).
             At qpos=0 this gives the hands-and-knees silhouette. -->
        <geom name="fl_upper_arm" type="capsule" fromto="0 0 0 -0.13 0 0"
              size="0.022" rgba="0.78 0.67 0.57 1"/>

        <body name="fl_forearm" pos="-0.13 0 0">
          <!-- Elbow: bends forearm down/back -->
          <joint name="fl_elbow" type="hinge" axis="0 1 0"
                 range="-0.2 2.2"/>
          <!-- Forearm: vertical, pointing down at qpos=0 -->
          <geom name="fl_forearm_geom" type="capsule" fromto="0 0 0 0 0 -0.12"
                size="0.018" rgba="0.78 0.67 0.57 1"/>
          <!-- Elbow knob (visual) -->
          <geom name="fl_elbow_knob" type="sphere" size="0.024"
                rgba="0.68 0.58 0.48 1" contype="0" conaffinity="0"/>

          <body name="fl_hand" pos="0 0 -0.12">
            <geom name="fl_hand_geom" type="sphere" size="0.028"
                  rgba="0.88 0.74 0.62 1" contype="1" conaffinity="1"
                  friction="1.5 0.5 0.1"/>
            <site name="fl_hand_site" pos="0 0 0" size="0.03" rgba="0 0 0 0"/>
          </body>
        </body>
      </body>

      <!-- ====== FRONT-RIGHT ARM ====== -->
      <body name="fr_shoulder" pos="0.10 0.10 -0.01">
        <joint name="fr_shoulder_pitch" type="hinge" axis="0 1 0"
               range="-1.4 1.4"/>
        <joint name="fr_shoulder_yaw" type="hinge" axis="0 0 1"
               range="-0.8 0.8"/>
        <geom name="fr_upper_arm" type="capsule" fromto="0 0 0 0.13 0 0"
              size="0.022" rgba="0.78 0.67 0.57 1"/>

        <body name="fr_forearm" pos="0.13 0 0">
          <joint name="fr_elbow" type="hinge" axis="0 1 0"
                 range="-0.2 2.2"/>
          <geom name="fr_forearm_geom" type="capsule" fromto="0 0 0 0 0 -0.12"
                size="0.018" rgba="0.78 0.67 0.57 1"/>
          <geom name="fr_elbow_knob" type="sphere" size="0.024"
                rgba="0.68 0.58 0.48 1" contype="0" conaffinity="0"/>

          <body name="fr_hand" pos="0 0 -0.12">
            <geom name="fr_hand_geom" type="sphere" size="0.028"
                  rgba="0.88 0.74 0.62 1" contype="1" conaffinity="1"
                  friction="1.5 0.5 0.1"/>
            <site name="fr_hand_site" pos="0 0 0" size="0.03" rgba="0 0 0 0"/>
          </body>
        </body>
      </body>

      <!-- ====== REAR-LEFT LEG ====== -->
      <body name="rl_hip" pos="-0.10 -0.10 -0.01">
        <joint name="rl_hip_pitch" type="hinge" axis="0 1 0"
               range="-1.4 1.4"/>
        <joint name="rl_hip_yaw" type="hinge" axis="0 0 1"
               range="-0.7 0.7"/>
        <geom name="rl_thigh" type="capsule" fromto="0 0 0 -0.13 0 0"
              size="0.025" rgba="0.78 0.67 0.57 1"/>

        <body name="rl_shin" pos="-0.13 0 0">
          <joint name="rl_knee" type="hinge" axis="0 1 0"
                 range="-0.2 2.2"/>
          <geom name="rl_shin_geom" type="capsule" fromto="0 0 0 0 0 -0.12"
                size="0.020" rgba="0.78 0.67 0.57 1"/>
          <geom name="rl_knee_knob" type="sphere" size="0.027"
                rgba="0.68 0.58 0.48 1" contype="0" conaffinity="0"/>

          <body name="rl_foot" pos="0 0 -0.12">
            <geom name="rl_foot_geom" type="sphere" size="0.028"
                  rgba="0.62 0.52 0.44 1" contype="1" conaffinity="1"
                  friction="1.5 0.5 0.1"/>
            <site name="rl_foot_site" pos="0 0 0" size="0.03" rgba="0 0 0 0"/>
          </body>
        </body>
      </body>

      <!-- ====== REAR-RIGHT LEG ====== -->
      <body name="rr_hip" pos="0.10 -0.10 -0.01">
        <joint name="rr_hip_pitch" type="hinge" axis="0 1 0"
               range="-1.4 1.4"/>
        <joint name="rr_hip_yaw" type="hinge" axis="0 0 1"
               range="-0.7 0.7"/>
        <geom name="rr_thigh" type="capsule" fromto="0 0 0 0.13 0 0"
              size="0.025" rgba="0.78 0.67 0.57 1"/>

        <body name="rr_shin" pos="0.13 0 0">
          <joint name="rr_knee" type="hinge" axis="0 1 0"
                 range="-0.2 2.2"/>
          <geom name="rr_shin_geom" type="capsule" fromto="0 0 0 0 0 -0.12"
                size="0.020" rgba="0.78 0.67 0.57 1"/>
          <geom name="rr_knee_knob" type="sphere" size="0.027"
                rgba="0.68 0.58 0.48 1" contype="0" conaffinity="0"/>

          <body name="rr_foot" pos="0 0 -0.12">
            <geom name="rr_foot_geom" type="sphere" size="0.028"
                  rgba="0.62 0.52 0.44 1" contype="1" conaffinity="1"
                  friction="1.5 0.5 0.1"/>
            <site name="rr_foot_site" pos="0 0 0" size="0.03" rgba="0 0 0 0"/>
          </body>
        </body>
      </body>

      <!-- ====== HEAD with stereo eyes ====== -->
      <body name="head_base" pos="0 0.14 0.05">
        <joint name="head_pan" type="hinge" axis="0 0 1"
               range="-1.2 1.2"/>
        <geom name="head_base_pivot" type="sphere" size="0.005"
              rgba="0 0 0 0" contype="0" conaffinity="0" density="10"/>

        <body name="head" pos="0 0 0.05">
          <joint name="head_tilt" type="hinge" axis="1 0 0"
                 range="-0.6 0.6"/>
          <!-- Head sphere -->
          <geom name="head_geom" type="sphere" size="0.048"
                rgba="0.82 0.72 0.62 1" contype="0" conaffinity="0"/>
          <!-- Face: lighter patch on front -->
          <geom name="face" type="sphere" size="0.049"
                pos="0 0.022 0" rgba="0.94 0.90 0.86 1"
                contype="0" conaffinity="0"/>
          <!-- Nose -->
          <geom name="nose" type="sphere" size="0.011"
                pos="0 0.052 -0.010" rgba="0.86 0.62 0.58 1"
                contype="0" conaffinity="0"/>
          <!-- Left eye pupil -->
          <geom name="eye_L" type="sphere" size="0.010"
                pos="0.022 0.050 0.018" rgba="0.08 0.08 0.15 1"
                contype="0" conaffinity="0"/>
          <!-- Right eye pupil -->
          <geom name="eye_R" type="sphere" size="0.010"
                pos="-0.022 0.050 0.018" rgba="0.08 0.08 0.15 1"
                contype="0" conaffinity="0"/>

          <!-- Stereo cameras: 5cm apart, 15° downward gaze, wide 90° FOV.
               xyaxes row1=camera-right, row2=camera-up (world coords tilted). -->
          <camera name="left_eye"  pos=" 0.022 0.050 0.018"
                  xyaxes="1 0 0  0 0.259 0.966" fovy="90"/>
          <camera name="right_eye" pos="-0.022 0.050 0.018"
                  xyaxes="1 0 0  0 0.259 0.966" fovy="90"/>
        </body>
      </body>

      <!-- Torso contact site -->
      <site name="torso_site" pos="0 0 0" size="0.11 0.15 0.06"
            type="box" rgba="0 0 0 0"/>
    </body>

    <!-- ============================================================
         TARGET BALL — bright red, slightly larger for stereo visibility
    ============================================================ -->
    <body name="target" pos="0 0.5 2.078">
      <joint name="target_free" type="free" armature="0" damping="0"/>
      <geom name="target_geom" type="sphere" size="0.053"
            rgba="1 0.12 0.12 1" contype="1" conaffinity="1" density="150"
            friction="0.8 0.3 0.1"/>
    </body>

    <!-- Observer cameras -->
    <camera name="overhead" pos="0 0 5.5" xyaxes="1 0 0 0 1 0" fovy="55"/>
    <camera name="ringside" pos="0 -2.5 2.4" xyaxes="1 0 0 0 0.12 0.993" fovy="45"/>
  </worldbody>

  <!-- ============================================================
       ACTUATORS — all torque-controlled except head (position servo)
  ============================================================ -->
  <actuator>
    <!-- Front-left arm -->
    <motor name="fl_shoulder_pitch_m" joint="fl_shoulder_pitch"
           ctrllimited="true" ctrlrange="-1 1" gear="20"/>
    <motor name="fl_shoulder_yaw_m"   joint="fl_shoulder_yaw"
           ctrllimited="true" ctrlrange="-1 1" gear="14"/>
    <motor name="fl_elbow_m"          joint="fl_elbow"
           ctrllimited="true" ctrlrange="-1 1" gear="16"/>
    <!-- Front-right arm -->
    <motor name="fr_shoulder_pitch_m" joint="fr_shoulder_pitch"
           ctrllimited="true" ctrlrange="-1 1" gear="20"/>
    <motor name="fr_shoulder_yaw_m"   joint="fr_shoulder_yaw"
           ctrllimited="true" ctrlrange="-1 1" gear="14"/>
    <motor name="fr_elbow_m"          joint="fr_elbow"
           ctrllimited="true" ctrlrange="-1 1" gear="16"/>
    <!-- Rear-left leg -->
    <motor name="rl_hip_pitch_m"  joint="rl_hip_pitch"
           ctrllimited="true" ctrlrange="-1 1" gear="22"/>
    <motor name="rl_hip_yaw_m"    joint="rl_hip_yaw"
           ctrllimited="true" ctrlrange="-1 1" gear="14"/>
    <motor name="rl_knee_m"       joint="rl_knee"
           ctrllimited="true" ctrlrange="-1 1" gear="18"/>
    <!-- Rear-right leg -->
    <motor name="rr_hip_pitch_m"  joint="rr_hip_pitch"
           ctrllimited="true" ctrlrange="-1 1" gear="22"/>
    <motor name="rr_hip_yaw_m"    joint="rr_hip_yaw"
           ctrllimited="true" ctrlrange="-1 1" gear="14"/>
    <motor name="rr_knee_m"       joint="rr_knee"
           ctrllimited="true" ctrlrange="-1 1" gear="18"/>
    <!-- Head: position-servo, slow (kp=5) -->
    <position name="head_pan_m"  joint="head_pan"
              ctrllimited="true" ctrlrange="-1.2 1.2" kp="5"/>
    <position name="head_tilt_m" joint="head_tilt"
              ctrllimited="true" ctrlrange="-0.6 0.6" kp="5"/>
  </actuator>

  <!-- ============================================================
       SENSORS
  ============================================================ -->
  <sensor>
    <jointpos name="fl_shoulder_pitch_pos" joint="fl_shoulder_pitch"/>
    <jointpos name="fl_shoulder_yaw_pos"   joint="fl_shoulder_yaw"/>
    <jointpos name="fl_elbow_pos"          joint="fl_elbow"/>
    <jointpos name="fr_shoulder_pitch_pos" joint="fr_shoulder_pitch"/>
    <jointpos name="fr_shoulder_yaw_pos"   joint="fr_shoulder_yaw"/>
    <jointpos name="fr_elbow_pos"          joint="fr_elbow"/>
    <jointpos name="rl_hip_pitch_pos"      joint="rl_hip_pitch"/>
    <jointpos name="rl_hip_yaw_pos"        joint="rl_hip_yaw"/>
    <jointpos name="rl_knee_pos"           joint="rl_knee"/>
    <jointpos name="rr_hip_pitch_pos"      joint="rr_hip_pitch"/>
    <jointpos name="rr_hip_yaw_pos"        joint="rr_hip_yaw"/>
    <jointpos name="rr_knee_pos"           joint="rr_knee"/>
    <jointpos name="head_pan_pos"          joint="head_pan"/>
    <jointpos name="head_tilt_pos"         joint="head_tilt"/>

    <jointvel name="fl_shoulder_pitch_vel" joint="fl_shoulder_pitch"/>
    <jointvel name="fl_shoulder_yaw_vel"   joint="fl_shoulder_yaw"/>
    <jointvel name="fl_elbow_vel"          joint="fl_elbow"/>
    <jointvel name="fr_shoulder_pitch_vel" joint="fr_shoulder_pitch"/>
    <jointvel name="fr_shoulder_yaw_vel"   joint="fr_shoulder_yaw"/>
    <jointvel name="fr_elbow_vel"          joint="fr_elbow"/>
    <jointvel name="rl_hip_pitch_vel"      joint="rl_hip_pitch"/>
    <jointvel name="rl_hip_yaw_vel"        joint="rl_hip_yaw"/>
    <jointvel name="rl_knee_vel"           joint="rl_knee"/>
    <jointvel name="rr_hip_pitch_vel"      joint="rr_hip_pitch"/>
    <jointvel name="rr_hip_yaw_vel"        joint="rr_hip_yaw"/>
    <jointvel name="rr_knee_vel"           joint="rr_knee"/>

    <touch name="fl_hand_touch"  site="fl_hand_site"/>
    <touch name="fr_hand_touch"  site="fr_hand_site"/>
    <touch name="rl_foot_touch"  site="rl_foot_site"/>
    <touch name="rr_foot_touch"  site="rr_foot_site"/>
    <touch name="torso_touch"    site="torso_site"/>
  </sensor>
</mujoco>
